rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Μόνο ο ιδιοκτήτης (με επιβεβαιωμένο email Google) έχει πρόσβαση — σε όλα.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "stratos.tampakis@gmail.com"
        && request.auth.token.email_verified == true;
    }
    match /years/{year}   { allow read, write: if isOwner(); }  // ημέρες ανά έτος
    match /config/{id}    { allow read, write: if isOwner(); }  // είδη, ρυθμίσεις, πρότυπο
    match /repo/{id}      { allow read, write: if isOwner(); }  // ρεπό που δόθηκαν
    match /blood/{id}     { allow read, write: if isOwner(); }  // αιμοδοσίες
    match /ots/{id}       { allow read, write: if isOwner(); }  // εξαγωγή OTS ανά έτος
    // Οτιδήποτε άλλο: κλειστό
    match /{document=**}  { allow read, write: if false; }
  }
}
